        "*://*.eglifarm.com/*",
        "*://*.endy.com/*",
        "*://*.fortycreekwhisky.com/*",
        "*://*.frankandoak.com/*",
        "*://*.godinguitars.com/*",
        "*://*.goodyear.ca/*",
        "*://*.ionclothing.ca/*",
